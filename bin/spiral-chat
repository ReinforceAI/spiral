#!/bin/bash
# spiral-chat — Interactive chat with Spiral compressed model
# Usage: spiral-chat [options]
#   --model NAME        Model name (default: qwen-25-7b-spiral)
#   --prompt "text"     Single prompt (non-interactive)
#   --max-tokens N      Max tokens to generate (default: 2048)
#   --pq                Enable PQ KV cache compression (default)
#   --no-pq             Disable PQ KV (use F16 KV, faster but more memory)
#   --greedy            Use greedy decoding (temperature=0)
#   --help              Show this help
set -e

SPIRAL_HOME="${SPIRAL_HOME:-$HOME/.spiral}"
DEFAULT_MODEL="qwen-25-7b-spiral"

# Find the llama-cli binary
find_binary() {
    local name="$1"
    if command -v "$name" &> /dev/null; then
        echo "$name"
    elif [ -x "$(brew --prefix 2>/dev/null)/bin/$name" ]; then
        echo "$(brew --prefix)/bin/$name"
    elif [ -x "./build/bin/$name" ]; then
        echo "./build/bin/$name"
    fi
}

LLAMA_CLI=$(find_binary "llama-cli")
if [ -z "$LLAMA_CLI" ]; then
    echo "Error: llama-cli not found. Install with: brew install spiral"
    exit 1
fi

# Parse arguments
MODEL_NAME="$DEFAULT_MODEL"
MAX_TOKENS=2048
PROMPT=""
USE_PQ=1
GREEDY=0
EXTRA_ARGS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --model)
            MODEL_NAME="$2"
            shift 2
            ;;
        --prompt)
            PROMPT="$2"
            shift 2
            ;;
        --max-tokens)
            MAX_TOKENS="$2"
            shift 2
            ;;
        --pq)
            USE_PQ=1
            shift
            ;;
        --no-pq)
            USE_PQ=0
            shift
            ;;
        --greedy)
            GREEDY=1
            shift
            ;;
        --help|-h)
            head -11 "$0" | tail -10 | sed 's/^# //'
            echo ""
            echo "Environment:"
            echo "  SPIRAL_HOME    Base directory (default: ~/.spiral)"
            exit 0
            ;;
        *)
            EXTRA_ARGS="$EXTRA_ARGS $1"
            shift
            ;;
    esac
done

# Resolve paths: ~/.spiral/models/<model-name>/<model-name>.gguf
MODEL_DIR="$SPIRAL_HOME/models/$MODEL_NAME"
MODEL_FILE="$MODEL_DIR/${MODEL_NAME}.gguf"
CODEBOOK_FILE="$MODEL_DIR/codebooks.spiralcb"

# Auto-download if model missing
if [ ! -f "$MODEL_FILE" ]; then
    echo "Model not found: $MODEL_FILE"
    echo "Downloading $MODEL_NAME (first run only)..."
    echo ""

    DOWNLOAD_CMD=$(find_binary "spiral-download")
    if [ -z "$DOWNLOAD_CMD" ]; then
        DOWNLOAD_CMD="$(dirname "$0")/spiral-download"
    fi
    if [ ! -x "$DOWNLOAD_CMD" ]; then
        echo "Error: spiral-download not found"
        exit 1
    fi

    $DOWNLOAD_CMD --model "$MODEL_NAME"
    echo ""
fi

# Build command
CMD="$LLAMA_CLI --model $MODEL_FILE -n $MAX_TOKENS"

# PQ KV cache — set codebook path so auto-discovery finds it
if [ "$USE_PQ" -eq 1 ] && [ -f "$CODEBOOK_FILE" ]; then
    export SPIRAL_CODEBOOK_PATH="$CODEBOOK_FILE"
    CMD="$CMD -ctk spiral_pq2 -ctv f16 -fa on"
fi

# Sampling
if [ "$GREEDY" -eq 1 ]; then
    CMD="$CMD --temp 0"
fi

# Single prompt or interactive
if [ -n "$PROMPT" ]; then
    CMD="$CMD -p \"$PROMPT\" --no-display-prompt -e"
else
    CMD="$CMD -cnv"
fi

CMD="$CMD $EXTRA_ARGS"

eval $CMD
