#!/bin/bash
# spiral-chat — Interactive chat with Spiral compressed model
# Usage: spiral-chat [options]
#   --model NAME        Model name (default: qwen-25-7b-spiral)
#   --prompt "text"     Single prompt (non-interactive)
#   --max-tokens N      Max tokens to generate (default: 2048)
#   --greedy            Use greedy decoding (temperature=0)
#   --ctx N             Context size (default: 8192)
#   --help              Show this help
set -e

SPIRAL_HOME="${SPIRAL_HOME:-$HOME/.spiral}"
DEFAULT_MODEL="qwen-25-7b-spiral"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Find binary: check PATH, then same dir, then brew, then local build
find_binary() {
    local name="$1"
    if command -v "$name" &> /dev/null; then
        command -v "$name"
    elif [ -x "$SCRIPT_DIR/$name" ]; then
        echo "$SCRIPT_DIR/$name"
    elif [ -x "$(brew --prefix 2>/dev/null)/bin/$name" ]; then
        echo "$(brew --prefix)/bin/$name"
    elif [ -x "./build/bin/$name" ]; then
        echo "./build/bin/$name"
    fi
}

LLAMA_CLI=$(find_binary "llama-cli")
if [ -z "$LLAMA_CLI" ]; then
    echo "Error: llama-cli not found. Install with: brew install reinforceai/spiral/spiral"
    exit 1
fi

# Parse arguments
MODEL_NAME="$DEFAULT_MODEL"
MAX_TOKENS=2048
PROMPT=""
GREEDY=0
CTX=8192
EXTRA_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --model)
            MODEL_NAME="$2"
            shift 2
            ;;
        --prompt)
            PROMPT="$2"
            shift 2
            ;;
        --max-tokens)
            MAX_TOKENS="$2"
            shift 2
            ;;
        --greedy)
            GREEDY=1
            shift
            ;;
        --ctx)
            CTX="$2"
            shift 2
            ;;
        --help|-h)
            head -10 "$0" | tail -9 | sed 's/^# //'
            echo ""
            echo "Environment:"
            echo "  SPIRAL_HOME    Base directory (default: ~/.spiral)"
            exit 0
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

# Resolve paths
MODEL_DIR="$SPIRAL_HOME/models/$MODEL_NAME"
MODEL_FILE="$MODEL_DIR/${MODEL_NAME}.gguf"
CODEBOOK_FILE="$MODEL_DIR/codebooks.spiralcb"

# Check if model exists, download if needed
if [ ! -f "$MODEL_FILE" ]; then
    echo "Model not found: $MODEL_FILE"
    echo "Downloading $MODEL_NAME (first run only)..."
    echo ""

    DOWNLOAD_CMD=$(find_binary "spiral-download")
    if [ -z "$DOWNLOAD_CMD" ]; then
        echo "Error: spiral-download not found"
        exit 1
    fi

    "$DOWNLOAD_CMD" --model "$MODEL_NAME"
    echo ""

    # Verify download succeeded
    if [ ! -f "$MODEL_FILE" ]; then
        echo "Error: Download failed. Model file not found: $MODEL_FILE"
        exit 1
    fi
fi

# Verify model file is readable
if [ ! -r "$MODEL_FILE" ]; then
    echo "Error: Cannot read model file: $MODEL_FILE"
    exit 1
fi

# Codebook is required for Spiral rotation matrices and Lloyd-Max centroids.
# Set SPIRAL_CODEBOOK_PATH always; it is consumed by the Spiral kernels even
# without PQ KV cache.
if [ -f "$CODEBOOK_FILE" ]; then
    export SPIRAL_CODEBOOK_PATH="$CODEBOOK_FILE"
fi

# Build command as array (avoids eval quoting issues)
# Stock f16 KV cache + flash attention. PQ KV path is disabled in v0.3.0;
# the .spiralcb is still loaded for weight rotation and Lloyd-Max centroids.
# --jinja enables embedded chat template rendering (required for Sarvam-30B,
# also correct for Qwen variants that ship a Jinja template).
CMD=(
    "$LLAMA_CLI"
    --model "$MODEL_FILE"
    -ngl 99
    -ctk f16 -ctv f16 -fa on
    -c "$CTX"
    -n "$MAX_TOKENS"
    --jinja
)

# Sampling
if [ "$GREEDY" -eq 1 ]; then
    CMD+=(--temp 0)
fi

# Single prompt or interactive
if [ -n "$PROMPT" ]; then
    CMD+=(-p "$PROMPT" --no-display-prompt -e)
else
    CMD+=(-cnv)
fi

# Append any extra args
CMD+=("${EXTRA_ARGS[@]}")

# Launch
exec "${CMD[@]}"
