#!/bin/bash
# spiral-serve — OpenAI-compatible API server for Spiral
# Usage: spiral-serve [options]
#   --model NAME        Model name (default: qwen-25-7b-spiral)
#   --port N            Port number (default: 8080)
#   --host ADDR         Host address (default: 127.0.0.1)
#   --ctx N             Context size (default: 8192)
#   --help              Show this help
#
# API: POST /v1/chat/completions (OpenAI-compatible)
set -e

SPIRAL_HOME="${SPIRAL_HOME:-$HOME/.spiral}"
DEFAULT_MODEL="qwen-25-7b-spiral"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

find_binary() {
    local name="$1"
    if command -v "$name" &> /dev/null; then
        command -v "$name"
    elif [ -x "$SCRIPT_DIR/$name" ]; then
        echo "$SCRIPT_DIR/$name"
    elif [ -x "$(brew --prefix 2>/dev/null)/bin/$name" ]; then
        echo "$(brew --prefix)/bin/$name"
    elif [ -x "./build/bin/$name" ]; then
        echo "./build/bin/$name"
    fi
}

LLAMA_SERVER=$(find_binary "llama-server")
if [ -z "$LLAMA_SERVER" ]; then
    echo "Error: llama-server not found. Install with: brew install reinforceai/spiral/spiral"
    exit 1
fi

# Parse arguments
MODEL_NAME="$DEFAULT_MODEL"
PORT=8080
HOST="127.0.0.1"
CTX=8192
EXTRA_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --model)
            MODEL_NAME="$2"
            shift 2
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --host)
            HOST="$2"
            shift 2
            ;;
        --ctx)
            CTX="$2"
            shift 2
            ;;
        --help|-h)
            head -11 "$0" | tail -10 | sed 's/^# //'
            echo ""
            echo "Example:"
            echo "  spiral-serve --model qwen-36-35b-spiral --port 8080"
            echo "  curl http://localhost:8080/v1/chat/completions \\"
            echo "    -H 'Content-Type: application/json' \\"
            echo "    -d '{\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}]}'"
            exit 0
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

# Resolve paths
MODEL_DIR="$SPIRAL_HOME/models/$MODEL_NAME"
MODEL_FILE="$MODEL_DIR/${MODEL_NAME}.gguf"
CODEBOOK_FILE="$MODEL_DIR/codebooks.spiralcb"

# Auto-download if model missing
if [ ! -f "$MODEL_FILE" ]; then
    echo "Model not found: $MODEL_FILE"
    echo "Downloading $MODEL_NAME (first run only)..."
    echo ""

    DOWNLOAD_CMD=$(find_binary "spiral-download")
    if [ -z "$DOWNLOAD_CMD" ]; then
        echo "Error: spiral-download not found"
        exit 1
    fi

    "$DOWNLOAD_CMD" --model "$MODEL_NAME"
    echo ""
fi

# Codebook is required for Spiral rotation matrices and Lloyd-Max centroids.
# Set SPIRAL_CODEBOOK_PATH always; it is consumed by the Spiral kernels even
# without PQ KV cache.
if [ -f "$CODEBOOK_FILE" ]; then
    export SPIRAL_CODEBOOK_PATH="$CODEBOOK_FILE"
fi

# Build command as array.
# Stock f16 KV cache + flash attention. PQ KV path is disabled in v0.3.0.
# --jinja enables Qwen chat template rendering for OpenAI-compatible completion.
CMD=(
    "$LLAMA_SERVER"
    --model "$MODEL_FILE"
    -ngl 99
    -ctk f16 -ctv f16 -fa on
    -c "$CTX"
    --host "$HOST"
    --port "$PORT"
    --jinja
)

CMD+=("${EXTRA_ARGS[@]}")

echo "Spiral API Server"
echo "================="
echo "Model:     $MODEL_NAME"
echo "GGUF:      $MODEL_FILE"
echo "Codebooks: $([ -f "$CODEBOOK_FILE" ] && echo "$CODEBOOK_FILE" || echo "MISSING — rotation will fail")"
echo "KV cache:  f16 (PQ KV disabled in v0.3.0)"
echo "Context:   $CTX tokens"
echo "Endpoint:  http://$HOST:$PORT/v1/chat/completions"
echo ""
echo "For HumanEval-style benchmarking, pass:"
echo "  chat_template_kwargs: {\"enable_thinking\": false}"
echo ""

exec "${CMD[@]}"
